{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["image", "auth"],
  "properties": {
    "image": {
      "type": "object",
      "required": ["repository"],
      "properties": {"repository": {"type": "string"}, "tag": {"type": "string"}}
    },
    "replicaCount": {"type": "integer", "minimum": 1},
    "auth": {
      "type": "object",
      "properties": {
        "mode": {"type": "string", "enum": ["none", "jwt", "entra-proxy"]},
        "resourceUrl": {"type": "string"},
        "preflight": {"type": "string", "enum": ["warn", "strict", "off"]},
        "entra": {
          "type": "object",
          "properties": {
            "cloud": {"type": "string", "enum": ["public", "usgov", "china"]},
            "tokenVersions": {"type": "array", "items": {"type": "string", "enum": ["1", "2"]}}
          }
        },
        "config": {"type": "object"}
      },
      "if": {"properties": {"mode": {"enum": ["jwt", "entra-proxy"]}}},
      "then": {"properties": {"resourceUrl": {"type": "string", "pattern": "^https?://"}}}
    }
  }
}
