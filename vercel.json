{
  "version": 2,
  "buildCommand": "python scripts/generate_server_card.py",
  "framework": "fastapi",
  "functions": {
    "app.py": {
      "maxDuration": 200
    }
  },
  "rewrites": [
    {
      "source": "/mcp",
      "destination": "/"
    },
    {
      "source": "/mcp/(.*)",
      "destination": "/"
    },
    {
      "source": "/((?!\\.well-known).*)",
      "destination": "/"
    }
  ],
  "env": {
    "KROKI_SERVER": "https://kroki.io",
    "VERCEL_OUTPUT_DIR": "/tmp/diagrams",
    "MCP_OUTPUT_DIR": "/tmp/diagrams",
    "FASTMCP_STATELESS_HTTP": "true",
    "MCP_URL_ONLY": "true",
    "MCP_MEMORY_ONLY": "true",
    "MCP_DIAGRAM_CACHE_SIZE": "0"
  },
  "installCommand": "bash scripts/vercel-install.sh"
}
