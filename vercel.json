{
  "version": 2,
  "buildCommand": "python -m mcp_core.build_static_server_card",
  "framework": "fastapi",
  "rewrites": [
    {
      "source": "/mcp",
      "destination": "/"
    },
    {
      "source": "/mcp/(.*)",
      "destination": "/"
    },
    {
      "source": "/((?!\\.well-known).*)",
      "destination": "/"
    }
  ],
  "env": {
    "KROKI_SERVER": "https://kroki.io",
    "VERCEL_OUTPUT_DIR": "/tmp/diagrams",
    "MCP_OUTPUT_DIR": "/tmp/diagrams",
    "FASTMCP_STATELESS_HTTP": "true",
    "MCP_URL_ONLY": "true",
    "MCP_MEMORY_ONLY": "true"
  },
  "installCommand": "bash scripts/vercel-install.sh"
}
