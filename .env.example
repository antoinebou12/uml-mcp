# Copy to .env and adjust. Do not commit .env.
# See docs/configuration.md for full options.

# Output directory for generated diagrams
# MCP_OUTPUT_DIR=./output

# Kroki (default: https://kroki.io)
# KROKI_SERVER=https://kroki.io
# USE_LOCAL_KROKI=false

# PlantUML (default: http://plantuml-server:8080)
# PLANTUML_SERVER=http://plantuml-server:8080
# USE_LOCAL_PLANTUML=false

# Optional
# LOG_LEVEL=INFO
# LIST_TOOLS=false

# Optional enterprise SSO (see docs/enterprise/README.md). Default: none (open).
# MCP_AUTH_MODE=jwt                      # none | jwt | entra-proxy
# MCP_AUTH_RESOURCE_URL=https://mcp.contoso.com/mcp
# MCP_AUTH_ENTRA_TENANT_ID=<tenant-guid>
# MCP_AUTH_ENTRA_CLIENT_ID=<api-app-client-id>
# MCP_AUTH_CONFIG_FILE=/etc/uml-mcp/auth.json   # optional JSON config (no secrets)
# entra-proxy only (generate a key: python -m mcp_core.auth keygen):
# MCP_AUTH_ENTRA_CLIENT_SECRET=
# MCP_AUTH_PROXY_ENCRYPTION_KEYS=k1:<base64url-32-bytes>
# MCP_ADMIN_UI=false
